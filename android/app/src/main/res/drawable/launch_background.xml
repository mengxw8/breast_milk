<?xml version="1.0" encoding="utf-8"?>
<!-- Window background while the Android process starts - shown before Flutter
     paints its first frame.

     Portrait cover (no stretch): scale to fill height, center horizontally and
     clip the sides. Matches Flutter BrandLaunchPage BoxFit.cover. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_splash_background" />
    <item>
        <bitmap
            android:gravity="fill_vertical|center_horizontal"
            android:src="@drawable/splash_art" />
    </item>
</layer-list>
