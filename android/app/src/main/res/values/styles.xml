<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         The Flutter splash (BrandLaunchPage) draws the full-bleed artwork on
         top of this, so the window background only has to match its top band
         to avoid a flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied as soon as the process has started, and behind the
         Flutter UI while it runs.

         The background is the splash artwork rather than the flat colour:
         FlutterActivity switches to NormalTheme in onCreate and only then
         builds its splash view, so it is *this* windowBackground that
         FlutterSplashView paints during the cold start. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
